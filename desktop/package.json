{
  "name": "cilikube-desktop",
  "version": "1.5.0",
  "private": true,
  "description": "CiliKube desktop shell (Electron + Go sidecar)",
  "main": "dist/main.js",
  "author": "ciliverse",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ciliverse/cilikube.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare:resources": "node scripts/prepare-sidecar.mjs",
    "start": "pnpm build && electron .",
    "pack:win": "pnpm prepare:resources && pnpm build && electron-builder --win --x64 --publish never",
    "pack:mac": "pnpm prepare:resources && pnpm build && electron-builder --mac --arm64 --publish never",
    "pack:linux": "pnpm prepare:resources && pnpm build && electron-builder --linux --x64 --publish never",
    "pack:dir": "pnpm prepare:resources && pnpm build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "build": {
    "appId": "website.cillian.cilikube",
    "productName": "CiliKube",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources-staging/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources-staging/web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources-staging/pkg",
        "to": "pkg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "CiliKube-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CiliKube-${version}-linux-${arch}.${ext}"
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CiliKube",
      "artifactName": "CiliKube-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "CiliKube-${version}-win-${arch}-portable.${ext}"
    },
    "dmg": {
      "artifactName": "CiliKube-${version}-mac-${arch}.${ext}"
    }
  }
}
